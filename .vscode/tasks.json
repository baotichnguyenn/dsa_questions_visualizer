{
  // Judges the problem folder that the active editor's file belongs to.
  // Paths are built from ${workspaceFolder}/practice.py so these keep working
  // no matter how deep a problem folder is nested (e.g. problems/<slug>/).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Judge current problem (browser)",
      "detail": "Results in the local web dashboard, with runtime and space analysis when accepted",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/practice.py",
        "${fileDirname}",
        "--gui"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "clear": true,
        "focus": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Judge current problem (terminal)",
      "detail": "Run the open file's problem against its testcases (LeetCode format)",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/practice.py",
        "${fileDirname}",
        "--plain"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Judge current problem (watch)",
      "detail": "Stay running and re-judge on every save. Ctrl-C in the panel to stop.",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/practice.py",
        "${fileDirname}",
        "-w"
      ],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false,
        "showReuseMessage": false
      },
      "problemMatcher": []
    }
  ]
}
